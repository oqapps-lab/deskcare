{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.20.0",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "credentialsSource": "local",
      "env": {
        "EXPO_PUBLIC_PREMIUM_BYPASS": "1"
      }
    },
    "simulator": {
      "extends": "base",
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_PREMIUM_BYPASS": "1"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "credentialsSource": "local",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      },
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_PREMIUM_BYPASS": "1"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "credentialsSource": "local",
      "autoIncrement": true,
      "ios": {
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "6Y6BFVDS4L",
        "ascAppId": "6767548896",
        "ascApiKeyPath": "/Users/evgenij/.appstoreconnect/private_keys/AuthKey_787835NFD8.p8",
        "ascApiKeyId": "787835NFD8",
        "ascApiKeyIssuerId": "2f01e90d-40ee-4f1d-9a37-651713378b40"
      }
    }
  }
}
