EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Adapty — public SDK key (Adapty dashboard → app → "Public SDK key")
EXPO_PUBLIC_ADAPTY_KEY=

# AppsFlyer — Dev Key + iOS Apple App ID
# Dev Key: AppsFlyer dashboard → any app → App Settings → Dev Key (single key per account)
# Apple App ID: numeric ID (1234567890) from ASC after the app listing is created
EXPO_PUBLIC_APPSFLYER_DEV_KEY=
EXPO_PUBLIC_APPSFLYER_APP_ID=

# TF-internal premium bypass. Set to `1` for TestFlight builds where IAP
# isn't live yet — every premium gate behaves as unlocked. Leave EMPTY
# for production builds (real entitlements come from Adapty webhook).
EXPO_PUBLIC_PREMIUM_BYPASS=

# Google Sign-In — from Google Cloud Console → APIs & Services → Credentials
# Web client ID is what Supabase Google provider validates against.
# iOS client ID is the *iOS* OAuth 2.0 client (separate from web).
# iOS URL scheme is the iOS client ID reversed (looks like com.googleusercontent.apps.NNN-xxx).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
